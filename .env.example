# AgenticCore HQ settings. scripts/setup.ps1 writes the real .env for you
# (it asks for each key on the VPS). Never commit .env or paste keys in chat.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Your own Telegram user id (numbers). The bot ignores everyone else.
TELEGRAM_OWNER_ID=

# --- Claude (the boss) ---
ANTHROPIC_API_KEY=
HQ_MODEL=claude-opus-5-5
# Fable 5.1 is used when you say /model fable (or the boss escalates a very hard job)
HQ_MODEL_HARD=claude-fable-5-1
# low | medium | high | xhigh | max
HQ_EFFORT=max

# --- Specialists (optional; leave empty to switch one off) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
# Model names: leave empty to pick the newest automatically (see: npm run models)
OPENAI_MODEL=
GEMINI_MODEL=
XAI_MODEL=
# Thinking levels for the specialists (GPT-6: xhigh = Extra High, steps down to high automatically)
OPENAI_REASONING=xhigh
GEMINI_THINKING=high
XAI_REASONING=high
OPENAI_IMAGE_MODEL=gpt-image-1
XAI_IMAGE_MODEL=grok-imagine-image-2.0
XAI_VIDEO_MODEL=grok-imagine-video-1.5
# Grok voices: Urdu and English (male)
VOICE_UR=naksh
VOICE_EN=orion

# --- GitHub (optional): fine-grained token for the repos the boss may work on ---
GH_TOKEN=

# --- Spending guard (US dollars, Claude) ---
DAILY_BUDGET_USD=30
JOB_BUDGET_USD=8

# --- Paths (defaults are fine) ---
# HQ_WORKSPACE=C:\AgenticCoreHQ\workspace
# CLAUDE_CODE_GIT_BASH_PATH=C:\Program Files\Git\bin\bash.exe
